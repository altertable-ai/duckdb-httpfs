# name: test/sql/copy/test_remote_head_forbidden.test
# description: Test Force download with server that doesn't want to give us the head
# group: [copy]

require httpfs

require json

# scripts/run_head_forbidden_server.py refuses HEAD with 401 and sends GET bodies chunked, without a length
require-env HEAD_FORBIDDEN_SERVER_URL

statement ok
FROM read_json('{HEAD_FORBIDDEN_SERVER_URL}/generations')

query I
SELECT len(_embedded.generations) FROM read_json('{HEAD_FORBIDDEN_SERVER_URL}/generations')
----
32
